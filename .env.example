<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mochii Dashboard</title>
    <style>
      :root {
        --purple: #C7CEEA;
        --sky: #B5D8EB;
        --ice: #E0F7FA;
        --dark: #3B3852;
      }

      body {
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, var(--ice), var(--sky));
        color: var(--dark);
        margin: 0;
        padding: 32px;
      }

      .card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(59, 56, 82, 0.15);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 10px 22px rgba(59, 56, 82, 0.08);
      }

      h1, h2 { margin-top: 0; }
      .status {
        display: inline-block;
        padding: 8px 12px;
        border-radius: 999px;
        background: var(--purple);
        color: var(--dark);
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Mochii Dashboard</h1>
      <div class="status">Online</div>
    </div>

    <div class="card">
      <h2>Quick links</h2>
      <ul>
        <li>Welcome settings</li>
        <li>Ticket overview</li>
        <li>Auto-responders</li>
        <li>Moderation logs</li>
      </ul>
    </div>

    <div class="card">
      <h2>Notes</h2>
      <p>This dashboard is a lightweight starter dashboard for Mochii. It reads the same SQLite database as the Discord bot.</p>
    </div>
  </body>
</html>
